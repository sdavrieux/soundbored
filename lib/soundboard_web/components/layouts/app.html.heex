<header class="phone-bar">
  <button
    type="button"
    class="sidebar-toggle"
    data-sidebar-toggle
    aria-label="Open menu"
    aria-controls="studio-sidebar"
  >
    <.icon name="hero-bars-3" class="h-6 w-6" />
  </button>
  <.link navigate="/" class="phone-brand">SoundBored</.link>
</header>
<div class="sidebar-backdrop" data-sidebar-toggle aria-hidden="true"></div>
<.live_component
  module={SoundboardWeb.Components.Layouts.Navbar}
  id="navbar"
  current_user={@current_user}
  current_path={@current_path}
  presences={@presences}
/>
<main class="studio-main">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
<SoundboardWeb.Components.Soundboard.RadioDesk.radio_desk
  volume={@studio_volume}
  capture={@studio_capture}
  naming={@studio_naming}
/>
