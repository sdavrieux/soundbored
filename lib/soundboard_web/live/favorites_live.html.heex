<div class="page">
  <header class="page-header">
    <div>
      <h1 class="page-title">Favorites</h1>
      <p class="page-subtitle">{length(@favorites)} of {@max_favorites} slots used</p>
    </div>
  </header>

  <%= if @current_user do %>
    <%= if @sounds_with_tags == [] do %>
      <div class="empty-state">
        <.icon name="hero-heart" class="w-10 h-10 text-gray-400" />
        <h2 class="text-lg font-semibold">You currently have no favorites</h2>
        <p>Tap the heart on any sound to keep it here for quick access.</p>
        <.link navigate="/" class="studio-button btn-primary mt-2">Browse sounds</.link>
      </div>
    <% else %>
      <div class="sound-grid">
        <SoundboardWeb.Components.Soundboard.SoundCard.sound_card
          :for={sound <- @sounds_with_tags}
          sound={sound}
          favorite={sound.id in @favorites}
          show_edit={false}
        />
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <p>Sign in to keep your favorite sounds here.</p>
    </div>
  <% end %>
</div>
