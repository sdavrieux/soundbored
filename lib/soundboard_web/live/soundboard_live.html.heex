<div class="page">
  <% shown = shown_sounds(assigns) %>
  <header class="page-header">
    <div>
      <h1 class="page-title">Sounds</h1>
      <p class="page-subtitle">
        <%= if @selected_tags != [] or @search_query != "" or @only_favorites do %>
          Showing {length(shown)} of {length(@uploaded_files)}
        <% else %>
          {length(@uploaded_files)} sounds
        <% end %>
      </p>
    </div>
    <div class="page-actions">
      <button
        phx-click="play_random"
        class="studio-button btn-secondary"
        title="Play a random sound from the ones shown"
      >
        <.icon name="hero-sparkles" class="w-5 h-5" /> Random
      </button>
      <%= if @current_user do %>
        <button
          id="toggle-selecting"
          phx-click="toggle_selecting"
          aria-pressed={to_string(@selecting)}
          class={["studio-button", if(@selecting, do: "btn-danger-soft", else: "btn-secondary")]}
        >
          {if @selecting, do: "Done", else: "Select"}
        </button>
      <% end %>
      <button phx-click="show_upload_modal" class="studio-button btn-primary">
        <.icon name="hero-plus" class="w-5 h-5" /> Add sound
      </button>
    </div>
  </header>

  <div class="filter-bar">
    <form phx-change="search" phx-submit="search" class="relative" role="search">
      <label for="sound-search" class="sr-only">Search sounds</label>
      <input
        id="sound-search"
        type="search"
        name="query"
        value={@search_query}
        placeholder="Search names and tags"
        phx-debounce="250"
        autocomplete="off"
        class="field pr-10"
      />
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
        <.icon name="hero-magnifying-glass" class="search-icon h-5 w-5 text-gray-400" />
        <svg
          class="search-spinner hidden animate-spin h-5 w-5 text-gray-400"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
          </circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
          </path>
        </svg>
      </div>
    </form>

    <% tags = all_tags(@uploaded_files) %>
    <% ordered_tags = @selected_tags ++ Enum.reject(tags, &tag_selected?(&1, @selected_tags)) %>
    <div id="tag-filters" class="chip-row" aria-label="Filter by tag">
      <button
        :if={@current_user}
        id="favorites-filter"
        phx-click="toggle_favorites_filter"
        aria-pressed={to_string(@only_favorites)}
        class={["chip", @only_favorites && "is-active"]}
      >
        <.icon name="hero-heart-solid" class="w-4 h-4" /> Favorites
      </button>
      <button
        :if={length(@selected_tags) > 1}
        id="tag-match-toggle"
        phx-click="toggle_tag_match"
        class="chip chip-clear"
        title={
          if @tag_match == :all,
            do: "Showing sounds with every selected tag. Tap to show sounds with any of them.",
            else: "Showing sounds with any selected tag. Tap to require all of them."
        }
      >
        <.icon name="hero-arrows-right-left" class="w-4 h-4" />
        {if @tag_match == :all, do: "Match all", else: "Match any"}
      </button>
      <.tag_filter_button
        :for={tag <- ordered_tags}
        tag={tag}
        selected_tags={@selected_tags}
        uploaded_files={@uploaded_files}
      />
      <button
        :if={@selected_tags != [] or @only_favorites}
        id="clear-tag-filters"
        phx-click="clear_tag_filters"
        class="chip chip-clear"
      >
        <.icon name="hero-x-mark" class="w-4 h-4" /> Clear
      </button>
    </div>
  </div>

  <%= if @selecting do %>
    <div id="selection-toolbar" class="selection-toolbar">
      <div class="flex items-center gap-2 w-full">
        <span class="font-semibold">{MapSet.size(@selected_ids)} selected</span>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          Only sounds you uploaded can be selected.
        </span>
      </div>
      <form
        id="tag-selected"
        phx-submit="tag_selected"
        class="flex gap-2 w-full sm:w-auto sm:flex-1"
      >
        <label for="tag-selected-input" class="sr-only">Tag to add to selected sounds</label>
        <input
          id="tag-selected-input"
          name="tag"
          autocomplete="off"
          placeholder="Add tag to selected"
          disabled={MapSet.size(@selected_ids) == 0}
          class="field flex-1 min-w-0"
        />
        <button
          type="submit"
          disabled={MapSet.size(@selected_ids) == 0}
          class="studio-button btn-primary"
        >
          Add tag
        </button>
      </form>
      <div class="flex flex-wrap gap-2">
        <button phx-click="select_visible" class="studio-button btn-secondary">
          Select all shown
        </button>
        <button
          phx-click="clear_selection"
          disabled={MapSet.size(@selected_ids) == 0}
          class="studio-button btn-secondary"
        >
          Clear
        </button>
        <button
          id="delete-selected"
          phx-click="show_bulk_delete_confirm"
          disabled={MapSet.size(@selected_ids) == 0}
          class="studio-button btn-danger"
        >
          Delete
        </button>
      </div>
    </div>
  <% end %>

  <%= cond do %>
    <% @loading_sounds -> %>
      <div class="loading-container">
        <div class="loading-spinner"></div>
      </div>
    <% @uploaded_files == [] -> %>
      <div class="empty-state">
        <.icon name="hero-musical-note" class="w-10 h-10 text-gray-400" />
        <h2 class="text-lg font-semibold">No sounds yet</h2>
        <p>Add a clip, or publish one from Saved moments.</p>
      </div>
    <% shown == [] -> %>
      <div class="empty-state">
        <p>No sounds match. Remove a filter or clear the search.</p>
        <button phx-click="clear_all_filters" class="studio-button btn-secondary">
          Show all sounds
        </button>
      </div>
    <% true -> %>
      <div class="sound-grid">
        <%= for sound <- shown do %>
          <.sound_card
            sound={sound}
            favorite={sound.id in @favorites}
            show_favorite={@current_user != nil}
            selecting={@selecting}
            selectable={@selecting && BulkDeleteFlow.deletable?(sound, assigns)}
            selected={MapSet.member?(@selected_ids, sound.id)}
          />
        <% end %>
      </div>
  <% end %>

  <%= if @show_modal do %>
    <.edit_modal
      flash={@flash}
      edit_name_error={@edit_name_error}
      current_user={@current_user}
      current_sound={@current_sound}
      tag_input={@tag_input}
      tag_suggestions={@tag_suggestions}
    />
    <%= if @show_delete_confirm do %>
      <.delete_modal {assigns} />
    <% end %>
  <% end %>

  <%= if @show_bulk_delete_confirm do %>
    <.bulk_delete_modal sounds={BulkDeleteFlow.selected_sounds(assigns)} />
  <% end %>

  <%= if @show_upload_modal do %>
    <.upload_modal {assigns} />
  <% end %>

  <script>
    window.addEventListener("phx:clear-tag-input", (e) => {
      document.getElementById("tag-input").value = "";
    })

    window.addEventListener("phx:stop-all-sounds", (e) => {
      // Stop all audio elements
      document.querySelectorAll('audio').forEach(audio => {
        audio.pause();
        audio.currentTime = 0;
      });
      
      // Reset all play/stop icons
      document.querySelectorAll('.play-icon').forEach(icon => {
        icon.classList.remove('hidden');
      });
      document.querySelectorAll('.stop-icon').forEach(icon => {
        icon.classList.add('hidden');
      });
    });
  </script>
</div>
